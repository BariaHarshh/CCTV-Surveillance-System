# Shared MongoDB Atlas development database
# Replace credentials locally. Never commit real credentials.
MONGODB_URI=mongodb+srv://shahidforjg97_db_user:JG_University@ai-campus-guardian.i494qhq.mongodb.net/?appName=AI-Campus-Guardian
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Camera credential encryption (32+ char random string; falls back to SESSION_SECRET in dev)
CAMERA_ENCRYPTION_KEY=change-me-camera-encryption-key-at-least-32-chars
ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-at-least-32-chars

# Initial Super Admin (development / first-run only — never commit real values)
INITIAL_SUPER_ADMIN_EMAIL=superadmin@aicampusguardian.com
INITIAL_SUPER_ADMIN_PASSWORD=ChangeMe123!
INITIAL_SUPER_ADMIN_NAME=Platform Super Admin
INITIAL_SUPER_ADMIN_USER_ID=superadmin

# Brute-force protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Session durations
SESSION_EXPIRES_MINUTES=60
REMEMBER_ME_DAYS=30

# Platform
ONLINE_THRESHOLD_SECONDS=120
DASHBOARD_POLL_INTERVAL_MS=30000
REDIS_URL=
STORAGE_URL=

# Email (CONSOLE | SMTP | SENDGRID | SES | RESEND)
EMAIL_PROVIDER=CONSOLE
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Payments (INTERNAL | STRIPE | RAZORPAY)
PAYMENT_PROVIDER=INTERNAL
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Push
PUSH_PROVIDER=
# When unset, push deliveries are SKIPPED (not claimed as delivered)

# Webhooks / AI / Payments (required in production)
WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret-at-least-32-chars

# Intelligence Layer — set AI_PROVIDER=NONE for tools-only mode
AI_PROVIDER=NONE
AI_PROVIDER_KEY=
AI_MODEL=
AI_BASE_URL=

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example: https://guardian.example.com
# Set when behind nginx/Cloudflare/ALB so rate limits use real client IPs
TRUST_PROXY=false

# Monitoring
INTERNAL_EVENTS_API_KEY=change-me-internal-events-key
MONITORING_TEST_MODE=true
# In production MONITORING_TEST_MODE is ignored; INTERNAL_EVENTS_API_KEY is required
